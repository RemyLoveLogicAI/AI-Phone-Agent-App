DATABASE_URL="file:./dev.db"
PORT=3001
NODE_ENV=development

# Twilio Credentials (Get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# AI / LLM (Get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview

# Voice AI - Deepgram ASR (Get from https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Voice AI - Cartesia TTS (Get from https://play.cartesia.ai)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
# Voice options: see https://play.cartesia.ai/

# WebSocket Server
WS_PORT=3002

# Voice AI Configuration
VOICE_LANGUAGE=en
VOICE_SAMPLE_RATE=16000
ENABLE_BARGE_IN=true
MAX_CALL_DURATION_SECONDS=1800

# Privacy
PRIVACY_MODE=HYBRID

# Logging
LOG_LEVEL=debug
ENABLE_EVENT_LOGGING=true
