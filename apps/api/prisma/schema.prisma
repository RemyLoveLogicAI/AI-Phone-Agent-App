generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CallOS relationships
  policies  Policy[]
  playbooks Playbook[]
  memories  Memory[]
}

model Contact {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  name        String?
  email       String?
  tags        String?  // JSON array
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // CallOS fields
  trustTier   Int      @default(0) // 0-4 trust tier
  trustScore  Float    @default(0.0) // Computed trust score
  isVIP       Boolean  @default(false)
  isBlocked   Boolean  @default(false)
  preferences String?  // JSON - caller preferences

  calls       Call[]
  messages    Message[]
  voicemails  Voicemail[]
  trustScores TrustScore[]
  memories    Memory[]
}

model Call {
  id          String   @id @default(uuid())
  sid         String   @unique // Twilio CallSid
  direction   String   // INBOUND, OUTBOUND
  status      String
  duration    Int?
  recordingUrl String?
  transcript  String?
  summary     String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())

  // CallOS fields
  playbookId  String?
  playbook    Playbook? @relation(fields: [playbookId], references: [id])
  intentDistribution String? // JSON - intent probabilities
  emotionalState String? // JSON - emotion signals
  trustScoreAtStart Float @default(0.0)
  trustScoreAtEnd Float @default(0.0)
  scamConfidence Float @default(0.0)
  wasEscalated Boolean @default(false)
  escalationReason String?
  actionsTaken String? // JSON array of actions

  // Relations
  events      CallEvent[]
  intelligencePack IntelligencePack?
}

model Message {
  id          String   @id @default(uuid())
  sid         String   @unique // Twilio MessageSid
  direction   String   // INBOUND, OUTBOUND
  body        String
  status      String
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
}

model Voicemail {
  id          String   @id @default(uuid())
  sid         String   @unique // Twilio RecordingSid
  duration    Int?
  url         String
  transcript  String?
  summary     String?
  isRead      Boolean  @default(false)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
}

// ============================================================================
// CallOS Models - Phase A (MVP)
// ============================================================================

// Call Ledger - Append-only event store for audit trail
model CallEvent {
  id          String   @id @default(uuid())
  callId      String
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  eventType   String   // transcript_delta, intent_update, tool_intent, policy_decision, tool_result, escalation, takeover, call_end
  timestamp   DateTime @default(now())
  payload     String   // JSON - event-specific data
  modelVersion String?  // Which model produced this event
  latencyMs   Int?     // Processing time in milliseconds

  @@index([callId, timestamp])
}

// Policy Engine - Tool permissions and guardrails
model Policy {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  toolPermissions String // JSON - tool permission configuration
  escalationTriggers String? // JSON array
  disclosureRules String? // JSON - what to share at each trust tier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Playbook - Conversation flow configuration
model Playbook {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  version     String   @default("1.0.0")
  author      String   @default("LoveLogicAI")
  isActive    Boolean  @default(true)

  // Persona configuration
  voiceId     String   @default("professional-female-us")
  speakingRate Float   @default(1.0)
  warmth      Float    @default(0.8)

  // Flow configuration
  openingVariants String // JSON array of opening lines
  qualificationFlow String? // JSON array of questions
  toolPermissions String? // JSON - playbook-specific tool permissions
  escalationTriggers String? // JSON array
  compliance  String? // JSON - disclosure and consent requirements
  retention   String? // JSON - data retention policies

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  calls       Call[]

  @@index([userId])
}

// Memory - Multi-layer memory system
model Memory {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  layer       String   // ephemeral, session, contact, org, outcome
  key         String   // Memory key/identifier
  value       String   // JSON - memory content

  isPinned    Boolean  @default(false) // Permanent preference
  isRedacted  Boolean  @default(false) // Has been redacted

  expiresAt   DateTime? // TTL for ephemeral/session
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, layer])
  @@index([contactId, layer])
}

// Trust Score - Track caller trust evolution
model TrustScore {
  id          String   @id @default(uuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  score       Float    // Computed trust score
  tier        Int      // 0-4 trust tier

  // Feature contributions
  stirShakenAttestation String? // A, B, C
  historicalCallCount Int @default(0)
  scamPatternScore Float @default(0.0)
  verificationMethod String? // otp, callback, voiceprint, known_details
  timeOfDayAnomaly Float @default(0.0)
  geographicConsistency Float @default(0.0)

  reason      String?  // Human-readable explanation
  createdAt   DateTime @default(now())

  @@index([contactId])
}

// Intelligence Pack - Post-call summary and insights
model IntelligencePack {
  id          String   @id @default(uuid())
  callId      String   @unique
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  // Summary fields (JSON for structured data)
  whatHappened String   // Summary of call
  whatTheyWant String   // Caller intent
  whatWeDid    String   // Actions taken
  whatYouShouldDo String // Recommended next steps
  riskFlags    String   // JSON array

  // Extracted entities
  entities     String   // JSON - caller_name, company, budget, etc.

  // Analysis
  intentDistribution String // JSON - intent probabilities
  actionsTaken String? // JSON array of actions
  suggestedFollowups String? // JSON array of suggested actions

  // Audit
  auditSummary String   // JSON - decisions, policy_checks, tools_invoked counts

  generatedAt DateTime @default(now())
  processingTimeMs Int? // How long it took to generate

  @@index([callId])
}
