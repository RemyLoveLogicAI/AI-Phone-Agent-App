generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  name        String?
  email       String?
  tags        String?  // JSON array
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  calls       Call[]
  messages    Message[]
  voicemails  Voicemail[]
}

model Call {
  id          String   @id @default(uuid())
  sid         String   @unique // Twilio CallSid
  direction   String   // INBOUND, OUTBOUND
  status      String
  duration    Int?
  recordingUrl String?
  transcript  String?
  summary     String?
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
}

model Message {
  id          String   @id @default(uuid())
  sid         String   @unique // Twilio MessageSid
  direction   String   // INBOUND, OUTBOUND
  body        String
  status      String
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
}

model Voicemail {
  id          String   @id @default(uuid())
  sid         String   @unique // Twilio RecordingSid
  duration    Int?
  url         String
  transcript  String?
  summary     String?
  isRead      Boolean  @default(false)
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
}
