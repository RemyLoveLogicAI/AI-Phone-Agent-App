DATABASE_URL="file:./dev.db"
PORT=3001
NODE_ENV=development

# Twilio Credentials (Replace with actual values)
TWILIO_ACCOUNT_SID=AC_PLACEHOLDER
TWILIO_AUTH_TOKEN=AUTH_TOKEN_PLACEHOLDER
TWILIO_PHONE_NUMBER=+15555555555

# AI / LLM
OPENAI_API_KEY=sk-PLACEHOLDER
OPENAI_MODEL=gpt-4-turbo-preview

# Voice AI - Deepgram ASR
DEEPGRAM_API_KEY=PLACEHOLDER

# Voice AI - Cartesia TTS
CARTESIA_API_KEY=PLACEHOLDER
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
# Voice options: see https://play.cartesia.ai/

# WebSocket Server
WS_PORT=3002

# Voice AI Configuration
VOICE_LANGUAGE=en
VOICE_SAMPLE_RATE=16000
ENABLE_BARGE_IN=true
MAX_CALL_DURATION_SECONDS=1800

# Privacy
PRIVACY_MODE=HYBRID

# Logging
LOG_LEVEL=debug
ENABLE_EVENT_LOGGING=true
